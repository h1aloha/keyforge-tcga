{
  "name": "KeyForge",
  "cardRotation": 90,
  "customHelp": "Æmber: use the number box in the panel. Keys: click a key to mark it as forged.\nExhaust a card = rotate it. Draw back up to 6 cards at the end of your turn.",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "house",
      "rarity"
    ],
    "formats": [
      {
        "title": "Archon Standard",
        "gameplay": "Standard",
        "deckRuleset": "Archon"
      }
    ],
    "deckRulesets": {
      "Archon": {
        "general": {
          "min": 36
        }
      }
    }
  },
  "gameplay": {
    "Standard": {
      "defaultNotes": "Active house: \nKeys forged: 0",
      "countersStartingValues": [],
      "mulligan": {
        "startingHandSize": 6,
        "mulliganCount": {
          "max": 1
        },
        "mulliganCycle": {
          "info": "Mulligan: shuffle your hand into your deck and draw one fewer card.",
          "steps": [
            "toBottom",
            "shuffle",
            "applyPenalty",
            "draw"
          ],
          "selectionRange": {
            "min": 6,
            "max": 99
          }
        }
      },
      "newTurn": {
        "drawOnStart": false
      },
      "tokens": [
        {
          "name": "RedKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-red.png",
          "isUnique": true
        },
        {
          "name": "BlueKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-blue.png",
          "isUnique": true
        },
        {
          "name": "YellowKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-yellow.png",
          "isUnique": true
        }
      ],
      "draggableTokens": [
        {
          "id": "Aember",
          "name": "Aember",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/aember.png"
        },
        {
          "id": "Damage",
          "name": "Damage",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/damage.png"
        },
        {
          "id": "Power",
          "name": "Power counter",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/power.png"
        },
        {
          "id": "Stun",
          "name": "Stun",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/stun.png"
        },
        {
          "id": "Ward",
          "name": "Ward",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/ward.png"
        },
        {
          "id": "Enrage",
          "name": "Enrage",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/enrage.png"
        }
      ],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "section": "Battleline"
            },
            {
              "direction": "row",
              "content": [
                {
                  "section": "Artifacts"
                },
                {
                  "section": "Tracker",
                  "style": {
                    "width": "20%"
                  }
                },
                {
                  "section": "Archives",
                  "style": {
                    "width": "20%"
                  }
                }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Battleline": {
            "isHidden": "no",
            "height": 20,
            "alignment": "CENTER",
            "isHorizontalAllowed": true
          },
          "Artifacts": {
            "isHidden": "no",
            "height": 14,
            "alignment": "CENTER",
            "isHorizontalAllowed": true
          },
          "Archives": {
            "isHidden": "opponent-only",
            "height": 14,
            "alignment": "START",
            "displayedTitle": "Archives (cartas guardadas)"
          },
          "Tracker": {
            "type": "custom",
            "defaultValue": {
              "aember": 0,
              "red": false,
              "blue": false,
              "yellow": false
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "1vh",
                  "height": "100%",
                  "color": "#ffffff",
                  "fontSize": "2vh"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "0.8vh"
                    }
                  },
                  "children": [
                    "Æmber",
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Tracker.aember }}"
                      },
                      "onChange": "game.data.Tracker.aember = value; chatLog('Æmber: ' + value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "gap": "0.6vh"
                    }
                  },
                  "children": [
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.4vh",
                          "padding": "0.4vh 0.8vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.red ? '🔑🔴' : '⬜🔴' }}",
                      "onClick": "game.data.Tracker.red = !game.data.Tracker.red; chatLog(game.data.Tracker.red ? 'forged the red key' : 'unforged the red key')"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.4vh",
                          "padding": "0.4vh 0.8vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.blue ? '🔑🔵' : '⬜🔵' }}",
                      "onClick": "game.data.Tracker.blue = !game.data.Tracker.blue; chatLog(game.data.Tracker.blue ? 'forged the blue key' : 'unforged the blue key')"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.4vh",
                          "padding": "0.4vh 0.8vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.yellow ? '🔑🟡' : '⬜🟡' }}",
                      "onClick": "game.data.Tracker.yellow = !game.data.Tracker.yellow; chatLog(game.data.Tracker.yellow ? 'forged the yellow key' : 'unforged the yellow key')"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "defaultRessources": {
    "backgrounds": []
  },
  "cards": {
    "dataUrl": "https://h1aloha.github.io/keyforge-tcga/cards.json",
    "cardBack": "https://h1aloha.github.io/keyforge-tcga/img/card-back.jpg",
    "cardBackColor": "#2b2b2b"
  },
  "translationsUrl": "https://h1aloha.github.io/keyforge-tcga/translations.json"
}