{
  "name": "KeyForge",
  "cardRotation": 90,
  "customHelp": "Æmber: use the number box in the panel. Keys: click a key to mark it as forged.\nExhaust a card = rotate it. Draw back up to 6 cards at the end of your turn.",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "house",
      "rarity"
    ],
    "formats": [
      {
        "title": "Archon Standard",
        "gameplay": "Standard",
        "deckRuleset": "Archon"
      }
    ],
    "deckRulesets": {
      "Archon": {
        "general": {
          "min": 36
        }
      }
    }
  },
  "gameplay": {
    "Standard": {
      "defaultNotes": "Active house: \nKeys forged: 0",
      "countersStartingValues": [],
      "mulligan": {
        "startingHandSize": 6,
        "mulliganCount": {
          "max": 1
        },
        "mulliganCycle": {
          "info": "Mulligan: shuffle your hand into your deck and draw one fewer card.",
          "steps": [
            "toBottom",
            "shuffle",
            "applyPenalty",
            "draw"
          ],
          "selectionRange": {
            "min": 6,
            "max": 99
          }
        }
      },
      "newTurn": {
        "drawOnStart": false
      },
      "tokens": [
        {
          "name": "RedKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-red.png",
          "isUnique": true
        },
        {
          "name": "BlueKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-blue.png",
          "isUnique": true
        },
        {
          "name": "YellowKey",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/key-yellow.png",
          "isUnique": true
        }
      ],
      "draggableTokens": [
        {
          "id": "Aember",
          "name": "Aember",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/aember.png"
        },
        {
          "id": "Damage",
          "name": "Damage",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/damage.png"
        },
        {
          "id": "Power",
          "name": "Power counter",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/power.png"
        },
        {
          "id": "Stun",
          "name": "Stun",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/stun.png"
        },
        {
          "id": "Ward",
          "name": "Ward",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/ward.png"
        },
        {
          "id": "Enrage",
          "name": "Enrage",
          "image": "https://h1aloha.github.io/keyforge-tcga/img/enrage.png"
        }
      ],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                {
                  "section": "Battleline"
                },
                {
                  "section": "Markers",
                  "style": {
                    "width": "12vh",
                    "flexShrink": 0
                  }
                }
              ]
            },
            {
              "direction": "row",
              "content": [
                {
                  "section": "Artifacts"
                },
                {
                  "section": "Tracker",
                  "style": {
                    "width": "26vh",
                    "flexShrink": 0
                  }
                },
                {
                  "section": "Archives",
                  "style": {
                    "width": "18%"
                  }
                }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Battleline": {
            "isHidden": "no",
            "height": 20,
            "alignment": "CENTER",
            "isHorizontalAllowed": true
          },
          "Artifacts": {
            "isHidden": "no",
            "height": 14,
            "alignment": "CENTER",
            "isHorizontalAllowed": true
          },
          "Archives": {
            "isHidden": "opponent-only",
            "height": 14,
            "alignment": "START",
            "displayedTitle": "Archives (cartas guardadas)"
          },
          "Tracker": {
            "type": "custom",
            "defaultValue": {
              "aember": 0,
              "red": false,
              "blue": false,
              "yellow": false
            },
            "events": {
              "onStart": "game.data.Tracker.aember = 0; game.data.Tracker.red = false; game.data.Tracker.blue = false; game.data.Tracker.yellow = false"
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "1.2vh",
                  "height": "100%",
                  "color": "#ffffff",
                  "fontSize": "2.2vh"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "1.2vh",
                      "flexWrap": "nowrap"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "props": {
                        "style": {
                          "whiteSpace": "nowrap",
                          "marginRight": "0.8vh",
                          "fontSize": "2.2vh"
                        }
                      },
                      "children": "Æmber"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.2vh",
                          "padding": "0.3vh 1vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "−",
                      "onClick": "game.data.Tracker.aember = Math.max(0, Number(game.data.Tracker.aember || 0) - 1); try { functions.chatLog('Æmber: ' + game.data.Tracker.aember) } catch (e) {}"
                    },
                    {
                      "type": "span",
                      "props": {
                        "style": {
                          "minWidth": "3vh",
                          "textAlign": "center",
                          "fontSize": "3vh",
                          "fontWeight": "bold"
                        }
                      },
                      "children": "{{ game.data.Tracker.aember }}"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.2vh",
                          "padding": "0.3vh 1vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "+",
                      "onClick": "game.data.Tracker.aember = Number(game.data.Tracker.aember || 0) + 1; try { functions.chatLog('Æmber: ' + game.data.Tracker.aember) } catch (e) {}"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "gap": "0.8vh"
                    }
                  },
                  "children": [
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.2vh",
                          "padding": "0.3vh 1vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.red ? '🔴 ✔' : '🔴 ✖' }}",
                      "onClick": "game.data.Tracker.red = game.data.Tracker.red ? false : true; try { functions.chatLog(game.data.Tracker.red ? 'forged the red key' : 'unforged the red key') } catch (e) {}"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.2vh",
                          "padding": "0.3vh 1vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.blue ? '🔵 ✔' : '🔵 ✖' }}",
                      "onClick": "game.data.Tracker.blue = game.data.Tracker.blue ? false : true; try { functions.chatLog(game.data.Tracker.blue ? 'forged the blue key' : 'unforged the blue key') } catch (e) {}"
                    },
                    {
                      "type": "button",
                      "props": {
                        "style": {
                          "fontSize": "2.2vh",
                          "padding": "0.3vh 1vh",
                          "cursor": "pointer"
                        }
                      },
                      "children": "{{ game.data.Tracker.yellow ? '🟡 ✔' : '🟡 ✖' }}",
                      "onClick": "game.data.Tracker.yellow = game.data.Tracker.yellow ? false : true; try { functions.chatLog(game.data.Tracker.yellow ? 'forged the yellow key' : 'unforged the yellow key') } catch (e) {}"
                    }
                  ]
                }
              ]
            }
          },
          "Markers": {
            "type": "custom",
            "defaultValue": {},
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexWrap": "wrap",
                  "justifyContent": "center",
                  "alignContent": "center",
                  "gap": "0.8vh",
                  "height": "100%",
                  "padding": "0.5vh"
                }
              },
              "children": [
                {
                  "type": "button",
                  "props": {
                    "title": "Æmber",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "🟠",
                  "onClick": "await functions.createCard('marker-aember', 'Battleline')"
                },
                {
                  "type": "button",
                  "props": {
                    "title": "Daño / Damage",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "💥",
                  "onClick": "await functions.createCard('marker-damage', 'Battleline')"
                },
                {
                  "type": "button",
                  "props": {
                    "title": "Contador de poder / Power counter",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "➕",
                  "onClick": "await functions.createCard('marker-power', 'Battleline')"
                },
                {
                  "type": "button",
                  "props": {
                    "title": "Aturdido / Stun",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "💫",
                  "onClick": "await functions.createCard('marker-stun', 'Battleline')"
                },
                {
                  "type": "button",
                  "props": {
                    "title": "Protección / Ward",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "🛡️",
                  "onClick": "await functions.createCard('marker-ward', 'Battleline')"
                },
                {
                  "type": "button",
                  "props": {
                    "title": "Enfurecido / Enrage",
                    "style": {
                      "fontSize": "2.4vh",
                      "padding": "0.3vh 0.8vh",
                      "cursor": "pointer"
                    }
                  },
                  "children": "😡",
                  "onClick": "await functions.createCard('marker-enrage', 'Battleline')"
                }
              ]
            }
          }
        }
      }
    }
  },
  "defaultRessources": {
    "backgrounds": []
  },
  "cards": {
    "dataUrl": "https://h1aloha.github.io/keyforge-tcga/cards.json",
    "cardBack": "https://h1aloha.github.io/keyforge-tcga/img/card-back.jpg",
    "cardBackColor": "#2b2b2b"
  },
  "translationsUrl": "https://h1aloha.github.io/keyforge-tcga/translations.json"
}